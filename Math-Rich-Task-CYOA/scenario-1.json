{
  "title": "Combined Facility Outer-11 System Diagnostic",
  "initialState": "welcome",
  "defaultUnrecognized": "[UNRECOGNIZED DIRECTIVE]: Directive '%INPUT%' not understood. Type 'help' to list valid terminal commands.",
  "states": {
    "welcome": {
      "type": "text",
      "content": [
        "====================================================================",
        " _  _  _ _____ _   _   ___  __  ___  _____ ",
        " | || || | ____| | | |/ _ \\|  \\/  |/ _ \\ ",
        " | || || |  _| | | | | | | | |\\/| |  __/ ",
        " | || || | |___| |_| | |_| | |  | | |___ ",
        "  \\_/\\_/|_____|\\___/ \\___/|_|  |_|\\____| ",
        "                                         ",
        "COMBINED FACILITY OUTER-11 DIAGNOSTIC TERMINAL",
        "SYSTEM VERSION 43.08.2a",
        "RESTRICTED ACCESS – CLEARANCE LEVEL 1",
        "====================================================================",
        "",
        "[SYSTEM] Authentication verified.",
        "Primary control menu loaded. Enter a [COMMAND] or option number below.",
        "Type 'help' at any time to display available commands.",
        "[1] RUN STATION [DIAGNOSTIC] ",
        "[2] VIEW SECURITY [LOGS]",
        "{INBOX_OPTION}",
        "[4] VIEW [NOTES]",
        "[5] ACCESS [EMERGENCY] RESPONSE TERMINAL"
      ],
      "dynamicLines": [
        {
          "token": "{INBOX_OPTION}",
          "defaultText": "[3] VIEW [INBOX]",
          "rules": [
            {
              "flags": ["new_message_1", "new_message_2", "new_message_3"],
              "condition": "any",
              "text": "[3] VIEW [INBOX] *"
            }
          ]
        }
      ],
      "commands": [
        {
          "input": ["help", "info", "?", "options"],
          "type": "text",
          "response": [
            "--------------------------------------------------------------------",
            "AVAILABLE TERMINAL COMMANDS:",
            "  1. [DIAGNOSTIC]                    : Check station sub-systems.",
            "  2. [LOGS]                          : Review security access logs.",
            "  3. [INBOX]                         : View your messages.",
            "  4. [NOTES]                         : Access personal engineer logbook.",
            "  5. [EMERGENCY]                     : Emergency override console (LOCKED).",
            "--------------------------------------------------------------------"
          ]
        },
        {
          "input": ["1", "run diagnostic", "diagnostic", "station"],
          "type": "state",
          "nextState": "diagnostic"
        },
        {
          "input": ["2", "security logs", "security", "logs"],
          "type": "text",
          "response": "[ERROR]: SYSTEM NONFUNCTIONAL - Security log database offline."
        },
        {
          "input": ["3", "inbox", "messages"],
          "type": "state",
          "nextState": "inbox"
        },
        {
          "input": ["4", "notes", "logbook"],
          "type": "state",
          "nextState": "notes"
        },
        {
          "input": ["5", "emergency", "emergency response terminal", "emergency response"],
          "type": "text",
          "response": "[ERROR]: ACCESS DENIED - REQUIRES CLEARANCE LEVEL 3"
        }
      ]
    },
    "inbox": {
      "type": "text",
      "content": [
        "--------------------------------------------------------------------",
        "EMPLOYEE #03395P INBOX :: DECK 07 LOCAL TERMINAL",
        "--------------------------------------------------------------------",
        "Enter the option number in [] next to a message to read its contents.",
        "Type 'home' or 'exit' to return to the primary control menu.",
        "",
        "--------------------------------------------------------------------",
        "{MESSAGE_1}",
        "--------------------------------------------------------------------"
      ],
      "dynamicLines": [
        {
          "token": "{MESSAGE_1}",
          "defaultText": "[NO MESSAGES IN BUFFER]",
          "rules": [
            {
              "flags": ["new_message_1"],
              "condition": "any",
              "text": "[1] Work Order - Power Fluctuations (NEW)"
            },
            {
              "flags": ["message_1"],
              "condition": "any",
              "text": "[1] Work Order - Power Fluctuations (READ)"
            }
          ]
        }
      ],
      "commands": [
        {
          "input": ["help", "info", "?", "options"],
          "type": "text",
          "response": [
            "--------------------------------------------------------------------",
            "INBOX COMMANDS:",
            "  Enter the number in [] to read a dispatch.",
            "  - 'home' / 'exit' / 'return' : Return to main terminal screen.",
            "--------------------------------------------------------------------"
          ]
        },
        {
          "input": ["1", "work order", "power fluctuations"],
          "type": "text",
          "requiredFlagsAny": ["new_message_1", "message_1"],
          "removeFlags": ["new_message_1"],
          "setFlags": ["message_1"],
          "response": [
            "====================================================================",
            "SUBJ: Work Order - Power Fluctuations",
            "FROM: Chief Engineer Vance (Deck 01 Maintenance)",
            "DATE: 2184.298 -- 08:42 SST",
            "====================================================================",
            "",
            "\"Hey - someone flagged some oddities in the power consumption of the",
            "life support system. Can you run a diagnostic and see what's up?\"",
            "",
            "===================================================================="
          ]
        },
        {
          "input": ["home", "exit", "return", "back", "main"],
          "type": "state",
          "nextState": "welcome"
        }
      ]
    },
    "diagnostic": {
      "type": "text",
      "content": [
        "--------------------------------------------------------------------",
        "STATION DIAGNOSTIC CONSOLE :: PRIMARY SYSTEMS MONITOR",
        "--------------------------------------------------------------------",
        "Type 'run' or 'scan' to execute a full station system diagnostic.",
        "Type 'home' or 'exit' to return to the primary control menu.",
        "--------------------------------------------------------------------",
        "{ENGINE_STATUS}",
        "{SOLAR_STATUS}",
        "{LIFESUPPORT_STATUS}",
        "{ESCAPE_STATUS}",
        "{AIRLOCK_STATUS}",
        "{DOCKING_STATUS}",
        "--------------------------------------------------------------------"
      ],
      "dynamicLines": [
        {
          "token": "{ENGINE_STATUS}",
          "defaultText": "[1] ENGINE: [STATUS UNKNOWN]",
          "rules": [
            {
              "flags": ["diagnostic_1"],
              "condition": "any",
              "text": "[1] ENGINE: [NOMINAL]"
            }
          ]
        },
        {
          "token": "{SOLAR_STATUS}",
          "defaultText": "[2] SOLAR GENERATORS: [STATUS UNKNOWN]",
          "rules": [
            {
              "flags": ["solar_recalibrated"],
              "condition": "any",
              "text": "[2] SOLAR GENERATORS: [NOMINAL]"
            },
            {
              "flags": ["diagnostic_1"],
              "condition": "any",
              "text": "[2] SOLAR GENERATORS: [UNKNOWN - INTERVENTION REQUIRED]"
            }
          ]
        },
        {
          "token": "{LIFESUPPORT_STATUS}",
          "defaultText": "[3] LIFE SUPPORT: [STATUS UNKNOWN]",
          "rules": [
            {
              "flags": ["solar_recalibrated"],
              "condition": "any",
              "text": "[3] LIFE SUPPORT: [WARNING]"
            },
            {
              "flags": ["diagnostic_1"],
              "condition": "any",
              "text": "[3] LIFE SUPPORT: [NOMINAL]"
            }
          ]
        },
        {
          "token": "{ESCAPE_STATUS}",
          "defaultText": "[4] ESCAPE PODS: [STATUS UNKNOWN]",
          "rules": [
            {
              "flags": ["diagnostic_1"],
              "condition": "any",
              "text": "[4] ESCAPE PODS: [NOMINAL]"
            }
          ]
        },
        {
          "token": "{AIRLOCK_STATUS}",
          "defaultText": "[5] AIR LOCKS: [STATUS UNKNOWN]",
          "rules": [
            {
              "flags": ["diagnostic_1"],
              "condition": "any",
              "text": "[5] AIR LOCKS: [NOMINAL]"
            }
          ]
        },
        {
          "token": "{DOCKING_STATUS}",
          "defaultText": "[6] DOCKING BAYS: [STATUS UNKNOWN]",
          "rules": [
            {
              "flags": ["diagnostic_1"],
              "condition": "any",
              "text": "[6] DOCKING BAYS: [NOMINAL]"
            }
          ]
        }
      ],
      "commands": [
        {
          "input": ["help", "info", "?", "options"],
          "type": "text",
          "response": [
            "--------------------------------------------------------------------",
            "DIAGNOSTIC CONSOLE COMMANDS:",
            "  - [1-6] / System Name : Query individual system telemetry.",
            "  - 'run' / 'scan'      : Execute full station diagnostic scan.",
            "  - 'home' / 'exit'     : Return to main menu.",
            "--------------------------------------------------------------------"
          ]
        },
        {
          "input": ["run", "scan", "execute", "run diagnostic", "run station diagnostic"],
          "type": "state",
          "setFlags": ["diagnostic_1"],
          "nextState": "diagnostic"
        },
        {
          "input": ["1", "engine"],
          "type": "text",
          "response": "[ENGINE]: Status nominal."
        },
        {
          "input": ["2", "solar", "solar generators"],
          "type": "redirect",
          "requiredFlagsAny": ["diagnostic_1"],
          "targetUrl": "puzzles/corrupted_power_logs.html",
          "nextState": "solar_resolved",
          "response": "[SYSTEM]: Accessing Solar Generator calibration module..."
        },
        {
          "input": ["2", "solar", "solar generators"],
          "type": "text",
          "requiredFlagsAny": ["solar_recalibrated"],
          "response": "[SYSTEM]: Solar Module status nominal. No further action required."
        },
        {
          "input": ["3", "life support"],
          "type": "text",
          "requiredFlagsAny": ["solar_recalibrated"],
          "targetUrl": "puzzles/life_support_diagnostic.html",
          "nextState": "life_support_diagnostic",
          "response": "[SYSTEM]: Accessing Life Support diagnostic module..."
        },
        {
          "input": ["3", "life support"],
          "type": "redirect",
          "response": "[LIFE SUPPORT]: Status nominal."
        },
        {
          "input": ["4", "escape pods", "escape"],
          "type": "text",
          "response": "[ESCAPE PODS]: Status nominal."
        },
        {
          "input": ["5", "air locks", "airlocks"],
          "type": "text",
          "response": "[AIR LOCKS]: Status nominal."
        },
        {
          "input": ["6", "docking bays", "docking"],
          "type": "text",
          "response": "[DOCKING BAYS]: Status nominal."
        },
        {
          "input": ["home", "exit", "return", "back", "main"],
          "type": "state",
          "nextState": "welcome"
        }
      ]
    },
    "solar_generator": {
      "type": "redirect",
      "targetUrl": "puzzles/corrupted_power_logs.html",
      "nextState": "solar_resolved",
      "fallbackText": "[SYSTEM]: Transferring interface to Solar Generator diagnostic module..."
    },
    "solar_resolved": {
      "type": "text",
      "content": [
        "--------------------------------------------------------------------",
        "[CALIBRATION COMPLETE]: Solar generator array output re-aligned.",
        "Primary power bus lock restored.",
        "--------------------------------------------------------------------",
        "Type 'diagnostic' to return to monitor screen or 'home' for main menu."
      ],
      "commands": [
        {
          "input": ["diagnostic", "back", "1"],
          "type": "state",
          "setFlags": ["solar_recalibrated"],
          "nextState": "diagnostic"
        },
        {
          "input": ["home", "exit", "2"],
          "type": "state",
          "setFlags": ["solar_recalibrated"],
          "nextState": "welcome"
        }
      ]
    },
    "notes" : {
      "type": "state",
      "content" : [
        "--------------------------------------------------------------------",
        "PERSONAL ENGINEER LOGBOOK",
        "--------------------------------------------------------------------",
        "{SOLAR_STATUS_ENTRY}",
        "-END OF LOG-"
      ],
      "dynamicLines": [
        {
          "token": "{SOLAR_STATUS_ENTRY}",
          "defaultText": "[NO LOG ENTRIES]",
          "rules": [
            {
              "flags": ["solar_recalibrated"],
              "condition": "any",
              "text": "[LOG ENTRY 001]: I was able to correct the corrupted power logs. It looks like the life support system is siphoning power from the other systems. I should check on the life support systems to see if there are any issues."
            }
          ]
        }
      ],
      "commands": [
        {
          "input": ["home", "exit", "return", "back", "main"],
          "type": "state",
          "nextState": "welcome"
        }, 
        
        {
          "input": ["help", "info", "?", "options"],
          "type": "text",
          "response": [
            "--------------------------------------------------------------------",
            "LOGBOOK COMMANDS:",
            "  - 'home' / 'exit' / 'return' : Return to main terminal screen.",
            "--------------------------------------------------------------------"
          ]
        }
      ]
    }
  }
}